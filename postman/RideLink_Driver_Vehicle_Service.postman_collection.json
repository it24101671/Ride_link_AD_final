                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"licenseNumber\": \"B1234567\",\n  \"serviceArea\": \"Colombo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers"]
            }
          }
        },
        {
          "name": "Invalid Coordinates (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 99.0,\n  \"longitude\": 190.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/location",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "location"]
            }
          }
        },
        {
          "name": "Unauthorized Driver Access (401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}"]
            }
          }
